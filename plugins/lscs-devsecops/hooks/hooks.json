{
  "description": "Load the LSCS safety rules into every session, and again after /clear and compaction",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "cat \"${CLAUDE_PLUGIN_ROOT}/rules/safety.md\"" }
        ]
      }
    ]
  }
}
